# Public Supabase project config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects may use this name instead of ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for ingestion/admin routes
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase projects may use this server-only key name.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=books

# Optional: needed only if you want scripts to apply supabase/schema.sql directly.
DATABASE_URL=

# AI providers
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2-preview
# Use http://localhost:3000 locally and your Vercel/domain URL in production.
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_APP_NAME=Sudan Middle School AI

# Gemini embeddings
# Production default uses OpenRouter-hosted Gemini embeddings.
EMBEDDING_PROVIDER=openrouter
# Required only when EMBEDDING_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# App security and limits
# Comma-separated admin emails, for example: admin@example.com,owner@example.com
ADMIN_EMAILS=
AI_RATE_LIMIT_PER_MINUTE=12
MAX_UPLOAD_MB=100
